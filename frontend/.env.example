# Desenvolvimento local — copie para .env
# URL base do backend (Spring Boot). Sem barra no final.
VITE_API_URL=http://localhost:8080

# true = mock em memória; false ou vazio = API real
VITE_USE_MOCK=false

# --- Backend (produção: PostgreSQL no Render) ---
# DATABASE_URL é injetada automaticamente ao vincular o Postgres no Render.
# Local continua com SQLite (perfil local).

# --- Backend (e-mail e boletos) ---
# SGI_EMAIL_ENABLED=false
# SGI_BOLETOS_STORAGE_PATH=./data/boletos-temp
# SGI_BOLETOS_MAX_FILE_SIZE_BYTES=10485760
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

