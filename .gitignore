# Backend - build e arquivos sensíveis
backend/target/
backend/src/main/resources/application-local.properties
backend/data/*.db
!backend/data/.gitkeep
backend/data/boletos-temp/
backend/data/.clientes-relatorio-hash

# Atalho local (junction) Backend -> backend — só para abrir no Cursor.
# No Windows o FS é case-insensitive: /Backend/ ignorava backend/ inteiro; usar negação explícita.
/Backend/
!backend/
!backend/**

